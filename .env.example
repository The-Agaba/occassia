# Occassia Docker Environment Configuration

# Database
POSTGRES_DB=occassia
POSTGRES_USER=occassia
POSTGRES_PASSWORD=occassia
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/occassia

# Backend Security
JWT_SECRET=occassia-dev-secret-key-change-in-production-min-256-bits-long!!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend Ports (default 5173 mapped to container 80)
PORT=8080
